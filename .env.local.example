# Copy this file to .env.local (and add the same keys to your Vercel project's
# Environment Variables settings) before running or deploying FitLife.
#
# All values come from your own Firebase project:
# Firebase Console -> Project settings -> General -> "Your apps" -> SDK setup and configuration
#
# Firebase Console -> Project settings -> Cloud Messaging -> Web Push certificates
# gives you NEXT_PUBLIC_FIREBASE_VAPID_KEY for push notifications.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Email address(es) allowed to sign in to /admin, comma separated.
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com
